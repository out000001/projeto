{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev && cd stitch_portal_de_extens_o_unicap/portal_de_extens_o_unicap && npm exec --yes --package=bun@1.3.11 -- bun install --frozen-lockfile",
  "buildCommand": "npm --prefix stitch_portal_de_extens_o_unicap/portal_de_extens_o_unicap run build",
  "outputDirectory": "stitch_portal_de_extens_o_unicap/portal_de_extens_o_unicap/dist",
  "rewrites": [
    {
      "source": "/api/portal",
      "destination": "/api/portal"
    },
    {
      "source": "/api/tracking",
      "destination": "/api/tracking"
    },
    {
      "source": "/api/projects",
      "destination": "/api/projects"
    },
    {
      "source": "/api/register",
      "destination": "/api/register"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
